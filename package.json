{
  "name": "hyeeun-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --require ./tests/register-typescript.cjs --test tests/notion-route.test.mjs tests/notion-viewer.test.mjs tests/refactor.test.mjs",
    "test:notion:integration": "node --test tests/notion-api.integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "assets:metadata": "node scripts/generate-image-metadata.cjs",
    "format": "prettier --write app components contexts data lib scripts docs *.mjs *.ts *.json README.md",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "perf:audit": "node scripts/performance-audit.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "1.5.0",
    "katex": "0.18.4",
    "lucide-react": "0.454.0",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "notion-client": "7.3.0",
    "notion-types": "7.12.1",
    "prismjs": "1.30.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-notion-x": "7.12.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "lighthouse": "13.5.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
